# Build context for: docker build -f swift-server/Dockerfile .
# Allowlist: nothing else (no .env, no .git, no build output, no docs) ever enters the image.
*
!swift-server/Package.swift
!swift-server/Package.resolved
!swift-server/Sources
!swift-server/Tests
!swift-server/Public
!data/sessions.json
!swift-server/.build
!swift-server/.build/out
!swift-server/.build/out/Products
!swift-server/.build/out/Products/Release-linux-aarch64
!swift-server/.build/out/Products/Release-linux-aarch64/hallway-track
!swift-server/.build/out/Products/Release-linux-aarch64/hallway-index
