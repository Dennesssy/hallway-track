{
  "name": "hallway-track-video",
  "private": true,
  "version": "0.1.0",
  "description": "3-minute narrated walkthrough video for Hallway Track, rendered with Remotion",
  "scripts": {
    "svgs": "node scripts/make-svgs.mjs",
    "narrate": "node scripts/narrate.mjs",
    "preview": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts HallwayTrack out/hallway-track.mp4 --concurrency=4"
  },
  "dependencies": {
    "@remotion/cli": "4.0.542",
    "@remotion/transitions": "4.0.542",
    "@remotion/web-renderer": "4.0.542",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.542"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "typescript": "^5.6.0"
  }
}
